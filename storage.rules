rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Photos de profil RH : /rh/photos/{employeId}
    match /rh/photos/{file} {
      allow read: if request.auth != null;
      // Limite à 5 Mo et type image
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Documents RH (contrats, pièces) : lecture/écriture authentifiée
    match /rh/documents/{file} {
      allow read, write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024;
    }

    // Refus par défaut pour tout le reste
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

# Caddy — HTTPS automatique (Let's Encrypt) + service de l'app + reverse-proxy API.

# Les domaines viennent des variables d'environnement DOMAIN_APP / DOMAIN_API / DOMAIN_SITE
# définies dans deploy/.env et injectées par docker-compose.

# --- Application ---

{$DOMAIN_APP} {
    encode gzip

    root * /srv/app
    try_files {path} /index.html
    file_server

    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

# --- API Supabase ---

{$DOMAIN_API} {
    reverse_proxy host.docker.internal:8000
}

# --- Site vitrine ---

{$DOMAIN_SITE} {
    encode gzip

    reverse_proxy termitiere-vitrine:80

    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

# --- Contact proxy ---

{$DOMAIN_CONTACT} {
    encode gzip

    reverse_proxy termitiere-contact-proxy:8081

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

# --- OAuth proxy ---

{$DOMAIN_OAUTH} {
    reverse_proxy termitiere-oauth-proxy:8080
}

# --- Publish proxy ---

{$DOMAIN_PUBLISH} {
    reverse_proxy termitiere-publish-proxy:8082
}

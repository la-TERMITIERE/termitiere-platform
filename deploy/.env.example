# Configuration du déploiement frontend (à copier en .env et compléter).
# cp .env.example .env

# Domaines (doivent pointer vers l'IP du VPS via des enregistrements DNS A).
DOMAIN_APP=app.latermitiere.com
DOMAIN_API=api.latermitiere.com

# Clé ANON du Supabase auto-hébergé (générée dans le .env du stack Supabase).
# C'est une clé PUBLIQUE (front) — pas la service_role (qui reste secrète, côté serveur).
VITE_SUPABASE_ANON_KEY=colle_ici_la_cle_anon_du_supabase_self_hosted

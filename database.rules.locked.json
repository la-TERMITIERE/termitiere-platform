// ⚠️ FICHIER OBSOLÈTE — conservé uniquement parce que d'anciens documents y renvoient.
//
// Son contenu d'origine était TROMPEUR : présenté comme « le verrouillage », il
// accordait en réalité `.read`/`.write` sur TOUT `tp/` à n'importe quel compte
// authentifié, SANS protection du rôle, SANS protection de `users_secret` et SANS
// journal d'audit inviolable. Le publier AFFAIBLISSAIT la sécurité.
//
// Il reprend désormais à l'identique l'ÉTAGE 1 (database.rules.json), afin qu'une
// publication par erreur reste sûre.
//
// → Utilisez directement :
//     database.rules.json         (étage 1 — publiable immédiatement)
//     database.rules.etage2.json  (étage 2 — après vérification de la connexion serveur)
{
  "rules": {
    ".read": false,
    ".write": false,

    "maxiagro": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "tp": {
      "users": {
        ".read": true,
        ".indexOn": ["login"],
        "$uid": {
          ".write": "auth != null && (auth.uid === $uid || root.child('tp/users').child(auth.uid).child('role').val().matches(/^(super_admin|pau|ge|directeur|admin|info)$/))",
          "role": {
            ".validate": "root.child('tp/users').child(auth.uid).child('role').val().matches(/^(super_admin|pau|ge|directeur|admin|info)$/) || newData.val() === data.val()"
          },
          "modules": {
            ".validate": "root.child('tp/users').child(auth.uid).child('role').val().matches(/^(super_admin|pau|ge|directeur|admin|info)$/) || newData.val() === data.val()"
          },
          "actif": {
            ".validate": "root.child('tp/users').child(auth.uid).child('role').val().matches(/^(super_admin|pau|ge|directeur|admin|info)$/) || newData.val() === data.val()"
          },
          "gerePartenaires": {
            ".validate": "root.child('tp/users').child(auth.uid).child('role').val().matches(/^(super_admin|pau|ge|directeur|admin|info)$/) || newData.val() === data.val()"
          },
          "agroCategories": {
            ".validate": "root.child('tp/users').child(auth.uid).child('role').val().matches(/^(super_admin|pau|ge|directeur|admin|info)$/) || newData.val() === data.val()"
          },
          "logistiqueSites": {
            ".validate": "root.child('tp/users').child(auth.uid).child('role').val().matches(/^(super_admin|pau|ge|directeur|admin|info)$/) || newData.val() === data.val()"
          },
          "gymSites": {
            ".validate": "root.child('tp/users').child(auth.uid).child('role').val().matches(/^(super_admin|pau|ge|directeur|admin|info)$/) || newData.val() === data.val()"
          },
          "login": {
            ".validate": "root.child('tp/users').child(auth.uid).child('role').val().matches(/^(super_admin|pau|ge|directeur|admin|info)$/) || newData.val() === data.val()"
          }
        }
      },

      "users_secret": {
        ".read": true,
        "$uid": {
          ".write": "auth != null && (auth.uid === $uid || root.child('tp/users').child(auth.uid).child('role').val().matches(/^(super_admin|pau|ge|directeur|admin|info)$/))"
        }
      },

      "audit_global": {
        ".read": "auth != null && root.child('tp/users').child(auth.uid).child('role').val().matches(/^(super_admin|pau|ge|directeur|admin|info)$/)",
        "$entryId": {
          ".write": "auth != null && !data.exists() && newData.exists()"
        }
      },

      "gym_clients": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": ["qrToken"]
      },
      "gym_presences": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": ["clientNom"]
      },
      "gym_abonnements": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": ["clientNom"]
      },

      "$other": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}

// RÈGLES DE SÉCURITÉ — ÉTAGE 2.
//
// ⚠️ NE PAS PUBLIER SANS LA VÉRIFICATION CI-DESSOUS. Cet étage ferme `users` et
// `users_secret`, dont dépend la connexion de REPLI. Si la connexion serveur ne
// fonctionne pas, PLUS PERSONNE NE PEUT SE CONNECTER.
//
// VÉRIFICATION PRÉALABLE OBLIGATOIRE (5 minutes) :
//   1. Netlify → Site settings → Environment variables : la variable
//      FIREBASE_SERVICE_ACCOUNT existe et contient le JSON complet du compte de
//      service (Console Firebase → Paramètres du projet → Comptes de service →
//      Générer une nouvelle clé privée).
//   2. Déployer, puis se connecter normalement à l'application.
//   3. Onglet Réseau du navigateur : la requête POST /.netlify/functions/login
//      doit répondre 200 avec un `token`.
//      Si elle répond `not_configured`, la connexion passe encore par le repli :
//      NE PAS publier cet étage — corriger d'abord la variable.
//
// ROLLBACK : republier database.rules.json (étage 1), la connexion revient.
//
// Cet étage supprime le dernier accès public : hachages de mots de passe,
// téléphones et annuaire ne sont plus lisibles sans compte.
{
  "rules": {
    ".read": false,
    ".write": false,

    "maxiagro": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "tp": {
      // Annuaire : lisible par un utilisateur authentifié uniquement
      // (ciblage des notifications, page Utilisateurs).
      "users": {
        ".read": "auth != null",
        ".indexOn": ["login"],
        "$uid": {
          ".write": "auth != null && (auth.uid === $uid || root.child('tp/users').child(auth.uid).child('role').val().matches(/^(super_admin|pau|ge|directeur|admin|info)$/))",
          "role": {
            ".validate": "root.child('tp/users').child(auth.uid).child('role').val().matches(/^(super_admin|pau|ge|directeur|admin|info)$/) || newData.val() === data.val()"
          },
          "modules": {
            ".validate": "root.child('tp/users').child(auth.uid).child('role').val().matches(/^(super_admin|pau|ge|directeur|admin|info)$/) || newData.val() === data.val()"
          },
          "actif": {
            ".validate": "root.child('tp/users').child(auth.uid).child('role').val().matches(/^(super_admin|pau|ge|directeur|admin|info)$/) || newData.val() === data.val()"
          },
          "gerePartenaires": {
            ".validate": "root.child('tp/users').child(auth.uid).child('role').val().matches(/^(super_admin|pau|ge|directeur|admin|info)$/) || newData.val() === data.val()"
          },
          "agroCategories": {
            ".validate": "root.child('tp/users').child(auth.uid).child('role').val().matches(/^(super_admin|pau|ge|directeur|admin|info)$/) || newData.val() === data.val()"
          },
          "logistiqueSites": {
            ".validate": "root.child('tp/users').child(auth.uid).child('role').val().matches(/^(super_admin|pau|ge|directeur|admin|info)$/) || newData.val() === data.val()"
          },
          "gymSites": {
            ".validate": "root.child('tp/users').child(auth.uid).child('role').val().matches(/^(super_admin|pau|ge|directeur|admin|info)$/) || newData.val() === data.val()"
          },
          "login": {
            ".validate": "root.child('tp/users').child(auth.uid).child('role').val().matches(/^(super_admin|pau|ge|directeur|admin|info)$/) || newData.val() === data.val()"
          }
        }
      },

      // FERMÉ AUX CLIENTS. Seul le SDK Admin (netlify/functions/login.js) y accède
      // — il ignore les règles. Le changement de mot de passe reste possible sur
      // son propre nœud.
      "users_secret": {
        "$uid": {
          ".read": false,
          ".write": "auth != null && (auth.uid === $uid || root.child('tp/users').child(auth.uid).child('role').val().matches(/^(super_admin|pau|ge|directeur|admin|info)$/))"
        }
      },

      "audit_global": {
        ".read": "auth != null && root.child('tp/users').child(auth.uid).child('role').val().matches(/^(super_admin|pau|ge|directeur|admin|info)$/)",
        "$entryId": {
          ".write": "auth != null && !data.exists() && newData.exists()"
        }
      },

      // Index pour les requêtes du carnet de présence MAXI-GYM (cf. étage 1
      // pour le détail) — les fonctions serveur ignorent ces règles de toute façon.
      "gym_clients": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": ["qrToken"]
      },
      "gym_presences": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": ["clientNom"]
      },
      "gym_abonnements": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": ["clientNom"]
      },

      "$other": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
